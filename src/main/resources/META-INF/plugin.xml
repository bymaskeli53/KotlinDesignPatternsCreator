<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>com.github.bymaskeli53.kotlindesignpatternscreator</id>
    <name>Kotlin Design Patterns Creator</name>
    <vendor email="muhammetemingundogar53@gmail.com" url="https://github.com/bymaskeli53">Muhammet Gündoğar</vendor>    <description><![CDATA[
        <p><b>Kotlin Design Patterns Creator</b> injects classic design patterns directly into the Kotlin class under your caret.</p>
        <p>Right-click anywhere inside a Kotlin class body and pick a pattern (Builder, Factory, Observer, Strategy). The plugin uses PSI to mutate the file in place &mdash; no new files are generated, and a single undo reverts the whole transformation.</p>
        <p>Works in IntelliJ IDEA and Android Studio.</p>
    ]]></description>

    <idea-version since-build="233"/>

    <depends>com.intellij.modules.platform</depends>
    <depends>org.jetbrains.kotlin</depends>
    <depends optional="true" config-file="plugin-android.xml">org.jetbrains.android</depends>

    <resource-bundle>messages.PluginBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
        <notificationGroup id="KotlinDesignPatternsCreator"
                           displayType="BALLOON"
                           bundle="messages.PluginBundle"
                           key="notification.groupName"/>
    </extensions>

    <actions>
        <group id="KotlinDesignPatternsCreator.Group"
               text="Kotlin Design Patterns Creator"
               description="Inject design patterns into the current Kotlin class"
               popup="true">
            <add-to-group group-id="EditorPopupMenu" anchor="first"/>
            <action id="KDPC.Builder"
                    class="com.github.bymaskeli53.kotlindesignpatternscreator.actions.BuilderAction"
                    text="Builder"
                    description="Generate a nested Builder + private constructor"/>
            <action id="KDPC.Factory"
                    class="com.github.bymaskeli53.kotlindesignpatternscreator.actions.FactoryAction"
                    text="Factory"
                    description="Generate Type enum, stub implementations, and create() factory"/>
            <action id="KDPC.Observer"
                    class="com.github.bymaskeli53.kotlindesignpatternscreator.actions.ObserverAction"
                    text="Observer"
                    description="Generate Observer interface, observer list, and notify methods"/>
            <action id="KDPC.Strategy"
                    class="com.github.bymaskeli53.kotlindesignpatternscreator.actions.StrategyAction"
                    text="Strategy"
                    description="Extract a method as a Strategy with delegating implementation"/>
        </group>
    </actions>
</idea-plugin>
